<?xml version="1.0"?>
<ruleset name="X-Fields">
    <description>Security and PHP compatibility gate for X-Fields.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <!-- Fail the build on errors only; warnings are tracked as technical debt -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.0"/>

    <!-- PHP 7.4 → 8.x compatibility -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Security: escaping, nonces, sanitization, SQL -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="x-fields"/>
            </property>
        </properties>
    </rule>

    <!-- Legacy code: report as warnings for now, tighten progressively -->
    <rule ref="WordPress.Security.EscapeOutput"><type>warning</type></rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"><type>warning</type></rule>
    <rule ref="WordPress.Security.NonceVerification"><type>warning</type></rule>
    <rule ref="WordPress.DB.PreparedSQL"><type>warning</type></rule>
</ruleset>
